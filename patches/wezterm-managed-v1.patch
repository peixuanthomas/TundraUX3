+                xpixel: 10,
+                ypixel: 20,
+            },
+            113,
+        )
+        .expect("ordinary fullscreen geometry must show the native QR");
+        assert_eq!(odd.module_pixels, 7);
+        assert_eq!(odd.width_cells, (113_usize * 7).div_ceil(10));
+        assert_eq!(odd.height_cells, (113_usize * 7).div_ceil(20));
+        assert!(odd.left_col + odd.width_cells < 170);
+        assert!(odd.top_row + odd.height_cells < 53);
+    }
