+    #[test]
+    fn qr_texture_keeps_integer_modules_and_four_module_quiet_zone() {
+        let code =
+            QrCode::encode_text("TUNDRA-PANIC-CAPSULE/1\nIncident: i\n", QrCodeEcc::High).unwrap();
+        let layout = qr_layout(
+            termwiz::terminal::ScreenSize {
+                rows: 53,
+                cols: 170,
+                xpixel: 10,
+                ypixel: 20,
+            },
+            code.size() as usize + 8,
+        )
+        .unwrap();
+        let Change::Image(image) = qr_change(&code, layout).unwrap() else {
+            panic!("recovery QR must remain a native image")
+        };
+        let encoded = image.image.data();
+        let ImageDataType::EncodedFile(encoded) = &*encoded else {
+            panic!("recovery QR must remain an encoded native image")
+        };
+        let data = image::load_from_memory(encoded).unwrap().to_rgba8();
+        let width = data.width() as usize;
+        let height = data.height() as usize;
+        let modules = code.size() as usize + 8;
+        let scale = layout.module_pixels;
+        assert_eq!(width, modules * scale);
+        assert_eq!(height, modules * scale);
+        let pixel = |x: usize, y: usize| data.get_pixel(x as u32, y as u32).0;
+        for y in 0..4 * scale {
+            for x in 0..width {
+                assert_eq!(pixel(x, y), [255, 255, 255, 255]);
+            }
+        }
+        for y in 0..modules {
+            for x in 0..modules {
+                let expected = if x >= 4
+                    && y >= 4
+                    && x < modules - 4
+                    && y < modules - 4
+                    && code.get_module((x - 4) as i32, (y - 4) as i32)
+                {
+                    [0, 0, 0, 255]
+                } else {
+                    [255, 255, 255, 255]
+                };
+                for pixel_y in y * scale..(y + 1) * scale {
+                    for pixel_x in x * scale..(x + 1) * scale {
+                        assert_eq!(pixel(pixel_x, pixel_y), expected);
+                    }
+                }
+            }
+        }
+    }
