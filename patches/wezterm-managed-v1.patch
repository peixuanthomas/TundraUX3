+        .unwrap();
+        assert_eq!(layout.module_pixels, 41);
+        assert!(layout.left_col + layout.width_cells <= 199);
+
+        // 113 is representative of a high-ECC panic capsule.  The previous
+        // exact-cell-divisibility rule rejected this ordinary 1707x1067-ish
+        // fullscreen geometry even though the native texture can be drawn
+        // safely with a ceil cell extent.
+        let odd = qr_layout(
+            termwiz::terminal::ScreenSize {
+                rows: 53,
