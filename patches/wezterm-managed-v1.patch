+#[cfg(feature = "tundra-kiosk")]
+fn run_tundra_recovery(command: TundraRecoveryCommand, credential: String) -> anyhow::Result<()> {
+    // Claim before creating a Mux, frontend or window.  A second launcher
+    // activation must be a short-lived focus request, not a second recovery
+    // session competing for the same incident/outcome files.
+    let activation_listener = match crate::kiosk::claim_instance()? {
+        crate::kiosk::InstanceClaim::Primary(listener) => listener,
+        crate::kiosk::InstanceClaim::Secondary => {
+            // `ActivationListener` has sent the fixed ACTIVATE request and
+            // focuses every existing GUI window on the main thread.  Preserve
+            // the same externally visible result as normal kiosk startup.
+            std::process::exit(76);
+        }
+    };
+
+    // A corrupt or absent projection must not hide the recovery surface.
+    // The fallback is itself sanitized and produces the deliberately minimal
+    // offline capsule required for a report-unavailable incident.
+    let handoff =
+        tundra_recovery::RecoveryHandoffV1::read_or_minimal(&command.handoff, &command.incident_id);
+    // Native image cells use the same blob-backed image atlas as ordinary GUI
+    // terminals. Recovery bypasses `async_run_terminal_gui`, so initialize
+    // that storage explicitly before the QR image reaches glyphcache.
+    wezterm_blob_leases::register_storage(Arc::new(
+        wezterm_blob_leases::simple_tempdir::SimpleTempDir::new_in(&*config::CACHE_DIR)?,
+    ))?;
+    let _mux = setup_tundra_recovery_mux();
+    let gui = crate::frontend::try_new()?;
+    // Keep the primary claim alive until the recovery window closes.  Its
+    // listener focuses this native page when a second launcher is invoked.
+    let _activation_guard = activation_listener.start();
+    let activity = Activity::new();
+    // Use precisely the same initial configuration snapshot that creates the
+    // kiosk window.  In particular, do not invent a 120x40 terminal with
+    // zero pixel dimensions here: the window used to start at kiosk's old
+    // 108x22 size, so the first frame wrapped before the fullscreen resize
+    // notification arrived and QR layout necessarily saw 0x0 pixels.
+    let size = config::configuration().initial_size(0, None);
+    promise::spawn::spawn(async move {
+        let code = mux::termwiztermtab::run(
+            size,
+            None,
+            move |terminal| tundra_recovery::run(terminal, handoff, command.outcome, credential),
+            None,
+        )
+        .await
+        .unwrap_or(1);
+        drop(activity);
+        // `termwiztermtab::run` has removed the only window by now.  An
+        // explicit process status makes Enter distinguishable from a close.
+        std::process::exit(code);
+    })
+    .detach();
