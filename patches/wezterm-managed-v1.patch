+#[cfg(all(feature = "tundra-kiosk", target_os = "macos"))]
+fn start_tundra_parent_guard() -> anyhow::Result<()> {
+    use anyhow::Context;
+
+    if std::env::var("TUNDRA_MANAGED_SESSION").as_deref() != Ok("1") {
+        return Ok(());
+    }
+
+    let expected_parent: i32 = std::env::var("TUNDRA_LAUNCHER_PID")
+        .context("managed kiosk is missing TUNDRA_LAUNCHER_PID")?
+        .parse()
+        .context("managed kiosk has an invalid TUNDRA_LAUNCHER_PID")?;
+    if expected_parent <= 1 || unsafe { libc::getppid() } != expected_parent {
+        anyhow::bail!("managed kiosk launcher parent is unavailable");
+    }
+    std::thread::Builder::new()
+        .name("tundra-launcher-parent-guard".to_string())
+        .spawn(move || loop {
+            std::thread::sleep(std::time::Duration::from_millis(250));
+            if unsafe { libc::getppid() } != expected_parent {
+                // The launcher created WezTerm as its process-group leader.
+                // Terminating group zero takes the PTY child with the GUI.
+                unsafe {
+                    libc::kill(0, libc::SIGTERM);
+                }
+                std::process::exit(125);
+            }
+        })
+        .context("starting managed kiosk parent guard")?;
+    Ok(())
+}
+
+#[cfg(all(feature = "tundra-kiosk", not(target_os = "macos")))]
+fn start_tundra_parent_guard() -> anyhow::Result<()> {
+    Ok(())
+}
