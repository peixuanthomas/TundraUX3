+//! Tundra's no-PTY recovery pane.
+//!
+//! Only the bounded watchdog `RecoveryHandoffV1` projection crosses this
+//! boundary.  This module never starts a shell and never reads an incident.
+
+use anyhow::{anyhow, Context};
+use image::codecs::png::PngEncoder;
+use image::{ExtendedColorType, ImageEncoder};
+use qrcodegen::{QrCode, QrCodeEcc};
+use serde::{Deserialize, Serialize};
+use std::fs::{self, OpenOptions};
+use std::io::{Read, Write as _};
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::time::Duration;
+use termwiz::cell::{unicode_column_width, CellAttributes};
+use termwiz::color::{AnsiColor, ColorAttribute};
+use termwiz::image::{ImageData, ImageDataType, TextureCoordinate};
+use termwiz::input::{InputEvent, KeyCode, KeyEvent};
+use termwiz::surface::{Change, CursorVisibility, Image, Position};
+use termwiz::terminal::Terminal;
+use unicode_segmentation::UnicodeSegmentation;
+
+pub const RESTART_EXIT_CODE: i32 = 74;
+const MAX_HANDOFF_BYTES: u64 = 16 * 1024;
+const MAX_CAPSULE_BYTES: usize = 1_200;
+const INITIAL_RESIZE_SETTLE: Duration = Duration::from_millis(500);
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RecoveryHandoffV1 {
+    schema_version: u32,
+    incident_id: String,
+    session_id: String,
+    occurred_at: String,
+    failure: Failure,
+    components: Components,
+    restart_count: u32,
+    #[serde(default)]
+    summary: String,
+    #[serde(default)]
+    traceback_frames: Vec<String>,
+    #[serde(default)]
+    report_available: bool,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Failure {
+    source: String,
+    exit_code: Option<i32>,
+    signal: Option<String>,
+}
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Components {
+    tundra: String,
+    shell: String,
+    wezterm: String,
+}
+
+#[derive(Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct RestartOutcome {
+    schema_version: u32,
+    origin: &'static str,
+    kind: &'static str,
+    code: i32,
+    incident_id: String,
+    restart_credential: String,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum State {
+    AwaitingRestart,
+    Restarting,
+}
+
+impl RecoveryHandoffV1 {
+    /// Loads the watchdog's restricted projection, falling back to the only
+    /// data the recovery CLI can safely trust when the projection itself is
+    /// absent or malformed.  Do not include the underlying error in this
+    /// handoff: errors can contain a local path and are not page/QR-safe.
+    pub fn read_or_minimal(path: &Path, expected_incident: &str) -> Self {
+        match Self::read(path, expected_incident) {
+            Ok(handoff) => handoff,
+            Err(error) => {
+                log::warn!(
+                    "Tundra recovery handoff unavailable; showing the minimal recovery page: {}",
+                    error.root_cause()
+                );
+                Self::minimal_unavailable(expected_incident)
+            }
+        }
+    }
+
+    fn minimal_unavailable(expected_incident: &str) -> Self {
+        let mut handoff = Self {
+            schema_version: 1,
+            incident_id: expected_incident.to_owned(),
+            session_id: "unavailable".to_owned(),
+            occurred_at: chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Secs, true),
+            failure: Failure {
+                source: "recovery handoff unavailable".to_owned(),
+                exit_code: None,
+                signal: None,
+            },
+            components: Components {
+                tundra: "unavailable".to_owned(),
+                shell: "unavailable".to_owned(),
+                wezterm: "unavailable".to_owned(),
+            },
+            restart_count: 0,
+            summary: "Detailed report unavailable".to_owned(),
+            traceback_frames: vec![],
+            report_available: false,
+        };
+        handoff.sanitize();
+        handoff
+    }
+
+    pub fn read(path: &Path, expected_incident: &str) -> anyhow::Result<Self> {
+        if !path.is_absolute() {
+            anyhow::bail!("recovery handoff path must be absolute")
+        }
+        if fs::symlink_metadata(path)
+            .context("inspect recovery handoff")?
+            .file_type()
+            .is_symlink()
+        {
+            anyhow::bail!("recovery handoff must not be a symlink");
+        }
+        let mut file = OpenOptions::new()
+            .read(true)
+            .open(path)
+            .context("open recovery handoff")?;
+        if file.metadata()?.len() > MAX_HANDOFF_BYTES {
+            anyhow::bail!("recovery handoff is too large");
+        }
+        let mut bytes = Vec::new();
+        Read::by_ref(&mut file)
+            .take(MAX_HANDOFF_BYTES + 1)
+            .read_to_end(&mut bytes)
+            .context("read recovery handoff")?;
+        if bytes.len() as u64 > MAX_HANDOFF_BYTES {
+            anyhow::bail!("recovery handoff is too large");
+        }
+        let mut value: Self = serde_json::from_slice(&bytes).context("parse RecoveryHandoffV1")?;
+        if value.schema_version != 1 {
+            anyhow::bail!("unsupported recovery handoff schema")
+        }
+        value.sanitize();
+        if value.incident_id != safe(expected_incident, 96) {
+            anyhow::bail!("recovery handoff incident mismatch")
+        }
+        Ok(value)
+    }
+
+    fn sanitize(&mut self) {
+        self.incident_id = safe(&self.incident_id, 96);
+        self.session_id = safe(&self.session_id, 96);
+        self.occurred_at = safe(&self.occurred_at, 64);
+        self.failure.source = safe(&self.failure.source, 96);
+        self.failure.signal = self.failure.signal.as_deref().map(|s| safe(s, 96));
+        self.components.tundra = safe(&self.components.tundra, 64);
+        self.components.shell = safe(&self.components.shell, 64);
+        self.components.wezterm = safe(&self.components.wezterm, 64);
+        self.summary = safe(&self.summary, 240);
+        self.traceback_frames = self
+            .traceback_frames
+            .iter()
+            .take(8)
+            .map(|s| safe(s, 240))
+            .collect();
+        if !self.report_available {
+            self.summary = "Detailed report unavailable".into();
+            self.traceback_frames.clear();
+        }
+    }
+
+    fn capsule(&self) -> String {
+        let mut frames = self.traceback_frames.clone();
+        let mut truncated = false;
+        loop {
+            let mut text = format!("TUNDRA-PANIC-CAPSULE/1\nIncident: {}\nSession: {}\nUTC: {}\nSource: {}\nExit: {}\nRestarts: {}\nVersions: tundra={} shell={} wezterm={}\nSummary: {}\n", self.incident_id, self.session_id, self.occurred_at, self.failure.source, failure_status(&self.failure), self.restart_count, self.components.tundra, self.components.shell, self.components.wezterm, self.summary);
+            for (index, frame) in frames.iter().enumerate() {
+                text.push_str(&format!("Frame {}: {}\n", index + 1, frame));
+            }
+            if truncated {
+                text.push_str("Trace: truncated\n");
+            }
+            text.push_str(&format!(
+                "Full details: Diagnostics > Logs > {}\n",
+                self.incident_id
+            ));
+            if text.len() <= MAX_CAPSULE_BYTES || frames.is_empty() {
+                return cap_capsule(text, &self.incident_id);
+            }
+            frames.pop();
+            truncated = true;
+        }
+    }
+}
+
+pub fn run(
+    mut term: mux::termwiztermtab::TermWizTerminal,
+    handoff: RecoveryHandoffV1,
+    outcome: PathBuf,
+    credential: String,
+) -> anyhow::Result<i32> {
+    term.no_grab_mouse_in_raw_mode();
+    term.set_raw_mode()?;
+    let mut state = State::AwaitingRestart;
+    // The frontend creates the window and asks the kiosk to enter fullscreen
+    // asynchronously.  Do not paint the first 120x40 virtual frame while the
+    // native viewport is still clamped to its pre-fullscreen geometry: that
+    // frame can put its bottom border and prompt below the visible rows.  A
+    // resize event carries the real pane cells and pixels.  The short timeout
+    // preserves a useful recovery screen on a backend that cannot publish it.
+    let _ = term.poll_input(Some(INITIAL_RESIZE_SETTLE))?;
+    loop {
+        render(&mut term, &handoff, state)?;
+        match term.poll_input(None)? {
+            Some(InputEvent::Key(KeyEvent {
+                key: KeyCode::Enter,
+                ..
+            })) if state == State::AwaitingRestart => {
+                state = State::Restarting;
+                render(&mut term, &handoff, state)?;
+                write_outcome(&outcome, &handoff.incident_id, &credential)?;
+                return Ok(RESTART_EXIT_CODE);
+            }
+            Some(_) => continue,  // Escape, mouse and every other key are inert.
+            None => return Ok(1), // Closing the window cannot look like a restart.
+        }
+    }
+}
+
+fn render(
+    term: &mut mux::termwiztermtab::TermWizTerminal,
+    handoff: &RecoveryHandoffV1,
+    state: State,
+) -> anyhow::Result<()> {
+    let size = term.get_screen_size()?;
+    let cols = size.cols;
+    let rows = size.rows;
+    let red = CellAttributes::default()
+        .set_background(ColorAttribute::TrueColorWithPaletteFallback(
+            (160, 0, 0).into(),
+            AnsiColor::Red.into(),
+        ))
+        .set_foreground(ColorAttribute::TrueColorWithPaletteFallback(
+            (255, 255, 255).into(),
+            AnsiColor::White.into(),
+        ))
+        .clone();
+    let white = CellAttributes::default()
+        .set_foreground(ColorAttribute::TrueColorWithPaletteFallback(
+            (255, 255, 255).into(),
+            AnsiColor::White.into(),
+        ))
+        .clone();
+    let yellow = CellAttributes::default()
+        .set_foreground(ColorAttribute::TrueColorWithPaletteFallback(
+            (255, 215, 0).into(),
+            AnsiColor::Yellow.into(),
+        ))
+        .clone();
+    let mut changes = vec![
+        Change::CursorPosition {
+            x: Position::Absolute(0),
+            y: Position::Absolute(0),
+        },
+        Change::ClearScreen(ColorAttribute::TrueColorWithPaletteFallback(
+            (0, 0, 0).into(),
+            AnsiColor::Black.into(),
+        )),
+        Change::CursorVisibility(CursorVisibility::Hidden),
+    ];
+    if is_compact_layout(cols, rows) {
+        // Never ask the terminal surface to wrap an emergency page: a small
+        // window gets one clipped, stable instruction and no QR image.
+        draw_frame(&mut changes, cols, rows, &red);
+        if rows > 2 {
+            fill_row(&mut changes, 1, cols, &red);
+            text_at(
+                &mut changes,
+                1,
+                1,
+                cols.saturating_sub(2),
+                "TUNDRAUX3 SESSION PANIC",
+                &red,
+            );
+        }
+        if rows > 3 {
+            fill_row(&mut changes, 2, cols, &red);
+            text_at(
+                &mut changes,
+                1,
+                2,
+                cols.saturating_sub(2),
+                "SYSTEM HALTED — RECOVERY LIMIT REACHED",
+                &red,
+            );
+        }
+        if rows > 6 {
+            text_at(
+                &mut changes,
+                1,
+                rows / 2,
+                cols.saturating_sub(2),
+                "TUNDRAUX3 PANIC — ENLARGE WINDOW TO CONTINUE",
+                &yellow,
+            );
+        }
+        let prompt = if state == State::Restarting {
+            "RESTARTING..."
+        } else {
+            "PRESS ENTER TO RESTART TUNDRAUX3"
+        };
+        if rows > 3 {
+            text_at(
+                &mut changes,
+                1,
+                rows.saturating_sub(2),
+                cols.saturating_sub(2),
+                prompt,
+                &yellow,
+            );
+        }
+        term.render(&changes)?;
+        term.flush()?;
+        return Ok(());
+    }
+
+    draw_frame(&mut changes, cols, rows, &red);
+    fill_row(&mut changes, 1, cols, &red);
+    fill_row(&mut changes, 2, cols, &red);
+    text_at(
+        &mut changes,
+        1,
+        1,
+        cols.saturating_sub(2),
+        "TUNDRAUX3 SESSION PANIC",
+        &red,
+    );
+    text_at(
+        &mut changes,
+        1,
+        2,
+        cols.saturating_sub(2),
+        "SYSTEM HALTED — AUTOMATIC RECOVERY LIMIT REACHED",
+        &red,
+    );
+    let capsule = handoff.capsule();
+    let code = QrCode::encode_text(&capsule, QrCodeEcc::High)
+        .map_err(|_| anyhow!("encode panic capsule QR"))?;
+    let layout = qr_layout(size, code.size() as usize + 8);
+    // The QR is placed before the right frame column and the textual panel
+    // uses only the remaining interior cells, so they can never overlap.
+    let text_width = layout
+        .map(|layout| layout.left_col.saturating_sub(2))
+        .unwrap_or_else(|| cols.saturating_sub(2));
+    let details = [
+        format!("UTC: {}", handoff.occurred_at),
+        format!("INCIDENT: {}", handoff.incident_id),
+        format!("SESSION: {}", handoff.session_id),
+        format!("FAULT: {}", handoff.failure.source),
+        format!("EXIT: {}", failure_status(&handoff.failure)),
+        format!("RECOVERY ATTEMPTS: {}", handoff.restart_count),
+        format!(
+            "VERSIONS: tundra {} | shell {} | wezterm {}",
+            handoff.components.tundra, handoff.components.shell, handoff.components.wezterm
+        ),
+        format!("SUMMARY: {}", handoff.summary),
+    ];
+    for (row, text) in details.iter().enumerate() {
+        text_at(&mut changes, 1, row + 4, text_width, text, &white);
+    }
+    for (index, frame) in handoff.traceback_frames.iter().enumerate() {
+        text_at(
+            &mut changes,
+            1,
+            13 + index,
+            text_width,
+            &format!("> {frame}"),
+            &white,
+        );
+    }
+    let prompt = if state == State::Restarting {
+        "RESTARTING..."
+    } else {
+        "PRESS ENTER TO RESTART TUNDRAUX3"
+    };
+    text_at(
+        &mut changes,
+        1,
+        rows.saturating_sub(3),
+        cols.saturating_sub(2),
+        prompt,
+        if state == State::Restarting {
+            &red
+        } else {
+            &yellow
+        },
+    );
+    if let Some(layout) = layout {
+        changes.push(Change::CursorPosition {
+            x: Position::Absolute(layout.left_col),
+            y: Position::Absolute(layout.top_row),
+        });
+        changes.push(qr_change(&code, layout)?);
+    } else {
+        text_at(
+            &mut changes,
+            1,
+            rows.saturating_sub(5),
+            cols.saturating_sub(2),
+            "PIXEL QR UNAVAILABLE — ENLARGE THE WINDOW TO VIEW THE OFFLINE CAPSULE",
+            &yellow,
+        );
+    }
+    term.render(&changes)?;
+    term.flush()?;
+    Ok(())
+}
+
+fn fill_row(changes: &mut Vec<Change>, row: usize, cols: usize, attributes: &CellAttributes) {
+    if cols == 0 {
+        return;
+    }
+    changes.push(Change::CursorPosition {
+        x: Position::Absolute(0),
+        y: Position::Absolute(row),
+    });
+    changes.push(Change::AllAttributes(attributes.clone()));
+    changes.push(Change::Text(" ".repeat(cols)));
+}
+
+fn draw_frame(changes: &mut Vec<Change>, cols: usize, rows: usize, red: &CellAttributes) {
+    fill_row(changes, 0, cols, red);
+    fill_row(changes, rows.saturating_sub(1), cols, red);
+    for row in 1..rows.saturating_sub(1) {
+        text_at(changes, 0, row, 1, " ", red);
+        text_at(changes, cols.saturating_sub(1), row, 1, " ", red);
+    }
+}
+
+fn text_at(
+    changes: &mut Vec<Change>,
+    column: usize,
+    row: usize,
+    width: usize,
+    text: &str,
+    attributes: &CellAttributes,
+) {
+    if width == 0 {
+        return;
+    }
+    changes.push(Change::CursorPosition {
+        x: Position::Absolute(column),
+        y: Position::Absolute(row),
+    });
+    changes.push(Change::AllAttributes(attributes.clone()));
+    changes.push(Change::Text(display_width(text, width)));
+}
+
+fn display_width(text: &str, width: usize) -> String {
+    let mut clipped = String::new();
+    for grapheme in text.graphemes(true) {
+        clipped.push_str(grapheme);
+        if unicode_column_width(&clipped, None) > width {
+            clipped.truncate(clipped.len() - grapheme.len());
+            break;
+        }
+    }
+    clipped
+}
+
+const fn is_compact_layout(cols: usize, rows: usize) -> bool {
+    cols < 80 || rows < 24
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+struct QrLayout {
+    left_col: usize,
+    top_row: usize,
+    width_cells: usize,
+    height_cells: usize,
+    module_pixels: usize,
+}
+
+fn qr_layout(size: termwiz::terminal::ScreenSize, modules: usize) -> Option<QrLayout> {
+    let text_cols = 48usize;
+    let top_rows = 4usize;
+    let bottom_rows = 4usize;
+    if size.cols <= text_cols
+        || size.rows <= top_rows + bottom_rows
+        || size.xpixel == 0
+        || size.ypixel == 0
+    {
+        return None;
+    }
+    // Reserve the final cell for the red right-hand frame.
+    let max_width = size.cols.saturating_sub(text_cols + 1) * size.xpixel;
+    let max_height = (size.rows - top_rows - bottom_rows) * size.ypixel;
+    let max_scale = (max_width / modules).min(max_height / modules);
+    // Keep the native RGBA texture itself on an integer module grid.  Its cell
+    // bounds may not divide the current cell pixels (especially for odd-sized
+    // high-ECC payloads), so use the smallest enclosing cell rectangle rather
+    // than throwing the QR away.  The texture remains black/white with an
+    // integer-pixel, four-module quiet zone; the GUI never falls back to a
+    // character QR.
+    let module_pixels = max_scale;
+    if module_pixels < 2 {
+        return None;
+    }
+    let image_pixels = modules * module_pixels;
+    let width_cells = image_pixels.div_ceil(size.xpixel);
+    let height_cells = image_pixels.div_ceil(size.ypixel);
+    if width_cells == 0
+        || height_cells == 0
+        || width_cells > size.cols.saturating_sub(text_cols + 1)
+        || height_cells > size.rows.saturating_sub(top_rows + bottom_rows)
+    {
+        return None;
+    }
+    Some(QrLayout {
+        left_col: size.cols.saturating_sub(1 + width_cells),
+        top_row: top_rows,
+        width_cells,
+        height_cells,
+        module_pixels,
+    })
+}
+
+fn qr_change(code: &QrCode, layout: QrLayout) -> anyhow::Result<Change> {
+    let quiet = 4usize;
+    let modules = code.size() as usize + quiet * 2;
+    let module_pixels = layout.module_pixels;
+    let pixels = modules * module_pixels;
+    let mut rgba = vec![255u8; pixels * pixels * 4];
+    for y in quiet..modules {
+        for x in quiet..modules {
+            if x < modules - quiet
+                && y < modules - quiet
+                && code.get_module((x - quiet) as i32, (y - quiet) as i32)
+            {
+                for pixel_y in y * module_pixels..(y + 1) * module_pixels {
+                    for pixel_x in x * module_pixels..(x + 1) * module_pixels {
+                        let at = (pixel_y * pixels + pixel_x) * 4;
+                        rgba[at..at + 3].copy_from_slice(&[0, 0, 0]);
+                    }
+                }
+            }
+        }
+    }
+    // TermWiz's in-memory terminal transports image Changes through its
+    // internal iTerm image parser. That path accepts encoded image bytes;
+    // passing Rgba8 reaches an upstream `unimplemented!()` and strands the
+    // recovery GUI on a black first frame. A PNG remains a native pixel image
+    // (never a character QR), is compact enough for the internal pipe, and is
+    // decoded by WezTerm's normal image atlas.
+    let mut png = Vec::new();
+    PngEncoder::new(&mut png)
+        .write_image(
+            &rgba,
+            pixels as u32,
+            pixels as u32,
+            ExtendedColorType::Rgba8,
+        )
+        .map_err(|_| anyhow!("encode panic capsule QR pixels"))?;
+    Ok(Change::Image(Image {
+        width: layout.width_cells,
+        height: layout.height_cells,
+        top_left: TextureCoordinate::new_f32(0., 0.),
+        bottom_right: TextureCoordinate::new_f32(1., 1.),
+        image: Arc::new(ImageData::with_data(ImageDataType::EncodedFile(png))),
+    }))
+}
+
+pub fn validate_restart_credential(credential: &str) -> anyhow::Result<()> {
+    if credential.len() != 64
+        || !credential
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        anyhow::bail!("invalid restart credential")
+    }
+    Ok(())
+}
+
+fn write_outcome(path: &Path, incident_id: &str, credential: &str) -> anyhow::Result<()> {
+    if !path.is_absolute() || path.file_name().is_none() {
+        anyhow::bail!("recovery outcome path must be absolute")
+    }
+    validate_restart_credential(credential)?;
+    let parent = path
+        .parent()
+        .ok_or_else(|| anyhow!("invalid recovery outcome path"))?;
+    let parent_metadata =
+        fs::symlink_metadata(parent).context("inspect recovery outcome directory")?;
+    if !parent_metadata.is_dir() || parent_metadata.file_type().is_symlink() {
+        anyhow::bail!("invalid recovery outcome directory")
+    }
+    if fs::symlink_metadata(path).is_ok() {
+        anyhow::bail!("recovery outcome already exists")
+    }
+    let bytes = serde_json::to_vec(&RestartOutcome {
+        schema_version: 1,
+        origin: "wezterm-native-recovery",
+        kind: "restart",
+        code: RESTART_EXIT_CODE,
+        incident_id: incident_id.to_owned(),
+        restart_credential: credential.to_owned(),
+    })?;
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(path)
+        .context("create recovery outcome")?;
+    file.write_all(&bytes)
+        .and_then(|_| file.sync_all())
+        .context("persist recovery outcome")?;
+    Ok(())
+}
+
+fn failure_status(failure: &Failure) -> String {
+    failure
+        .exit_code
+        .map(|code| format!("exit {code}"))
+        .or_else(|| failure.signal.clone())
+        .unwrap_or_else(|| "unknown".into())
+}
+fn safe(value: &str, limit: usize) -> String {
+    let compact = value
+        .chars()
+        .map(|character| {
+            if character.is_control() {
+                ' '
+            } else {
+                character
+            }
+        })
+        .collect::<String>()
+        .split_whitespace()
+        .collect::<Vec<_>>()
+        .join(" ");
+    let lower = compact.to_ascii_lowercase();
+    // The handoff is supposed to have been scrubbed by the watchdog, but the
+    // GUI treats every value as hostile again. If it resembles an absolute
+    // local path or a prohibited raw diagnostic channel, retain no suffix.
+    if contains_absolute_path(&lower) || contains_sensitive_content(&lower) {
+        return "[redacted]".to_owned();
+    }
+    truncate_utf8_bytes(&compact, limit).to_owned()
+}
+
+fn contains_sensitive_content(lower: &str) -> bool {
+    const MARKERS: &[&str] = &[
+        "token=",
+        "token:",
+        "token ",
+        "secret",
+        "api key",
+        "api-key",
+        "api_key",
+        "apikey",
+        "authorization",
+        "bearer ",
+        "password",
+        "passwd",
+        "credential",
+        "argv",
+        "command line",
+        "environment",
+        "env=",
+        "clipboard",
+        "raw stderr",
+        "stderr",
+        "raw input",
+        "username",
+        "user=",
+    ];
+    MARKERS.iter().any(|marker| lower.contains(marker))
+}
+
+fn contains_absolute_path(lower: &str) -> bool {
+    if lower.as_bytes().windows(3).any(|window| {
+        window[0].is_ascii_alphabetic() && window[1] == b':' && matches!(window[2], b'/' | b'\\')
+    }) {
+        return true;
+    }
+    if lower.contains("\\\\") || lower.starts_with("//") || lower.contains(" //") {
+        return true;
+    }
+    let bytes = lower.as_bytes();
+    bytes.iter().enumerate().any(|(index, byte)| {
+        if *byte != b'/' {
+            return false;
+        }
+        let boundary = index == 0
+            || bytes[index - 1].is_ascii_whitespace()
+            || matches!(
+                bytes[index - 1],
+                b'(' | b'[' | b'{' | b'=' | b':' | b'\'' | b'"'
+            );
+        let path_body = bytes
+            .get(index + 1)
+            .is_some_and(|next| next.is_ascii_alphanumeric() || matches!(next, b'.' | b'_' | b'-'));
+        boundary && path_body
+    })
+}
+
+fn cap_capsule(text: String, incident_id: &str) -> String {
+    if text.len() <= MAX_CAPSULE_BYTES {
+        return text;
+    }
+    let footer = format!("Full details: Diagnostics > Logs > {incident_id}\n");
+    let marker = "Capsule: truncated\n";
+    let limit = MAX_CAPSULE_BYTES.saturating_sub(footer.len() + marker.len());
+    let body = truncate_utf8_bytes(text.strip_suffix(&footer).unwrap_or(&text), limit);
+    format!("{body}{marker}{footer}")
+}
+
+fn truncate_utf8_bytes(value: &str, limit: usize) -> &str {
+    if value.len() <= limit {
+        return value;
+    }
+    let mut end = limit;
+    while end > 0 && !value.is_char_boundary(end) {
+        end -= 1;
+    }
+    &value[..end]
+}
