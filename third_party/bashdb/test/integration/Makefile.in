all: all-am

.SUFFIXES:
.SUFFIXES: .log .test .trs
$(srcdir)/Makefile.in: @MAINTAINER_MODE_TRUE@ $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign test/integration/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign test/integration/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure: @MAINTAINER_MODE_TRUE@ $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4): @MAINTAINER_MODE_TRUE@ $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):
test-bash-rematch: $(top_builddir)/config.status $(srcdir)/test-bash-rematch.in
	cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@
test-bug-break: $(top_builddir)/config.status $(srcdir)/test-bug-break.in
	cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@
test-bug-step-subshell: $(top_builddir)/config.status $(srcdir)/test-bug-step-subshell.in
	cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@
test-complete: $(top_builddir)/config.status $(srcdir)/test-complete.in
	cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@
test-debug: $(top_builddir)/config.status $(srcdir)/test-debug.in
	cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@
test-delete: $(top_builddir)/config.status $(srcdir)/test-delete.in
	cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@
test-export: $(top_builddir)/config.status $(srcdir)/test-export.in
	cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@
