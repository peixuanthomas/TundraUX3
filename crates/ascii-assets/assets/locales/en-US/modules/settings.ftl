settings-field-name =
    { $field ->
        [Theme] { settings-theme }
        [ShowHidden] { settings-show-hidden }
        [ShowSystem] { settings-show-system }
        [ShowExtensions] { settings-show-extensions }
        [FoldersFirst] { settings-folders-first }
        [ShowSidebar] { settings-quick-access }
        [CaseSensitiveSort] { settings-case-sensitive }
        [SizeFormat] { settings-size-format }
        [DateZone] { settings-date-timezone }
        [SortField] { settings-sort-field }
        [SortDirection] { settings-sort-direction }
        [ConfirmDelete] { settings-delete-confirmation }
        [ConfirmNameConflicts] { settings-conflict-confirmation }
        [ExplorerOpenExtensions] { settings-explorer-suffixes }
        [CursorAcceleration] { settings-cursor-acceleration }
        [CursorDelay] { settings-cursor-delay }
        [CursorRamp] { settings-cursor-ramp }
        [CursorHorizontalStep] { settings-horizontal-maximum }
        [CursorVerticalStep] { settings-vertical-maximum }
        [BorderShape] { settings-border-shape }
        [BorderColor] { settings-border-color }
        [AccentColor] { settings-accent-color }
        [MotionPreference] { settings-motion }
        [AnimationSpeed] { settings-animation-speed }
        [ResetAnimationSpeed] { settings-speed-default }
        [Language] { settings-language }
        [Timezone] { settings-timezone }
        [TimeSyncSource] { settings-time-source }
        [TimeSyncServer] { settings-time-server }
        [WeatherLocation] { settings-weather-location }
        [SystemLowAvailable] { settings-low-available }
        [SystemLowPercentage] { settings-low-percentage }
        [SystemCriticalAvailable] { settings-critical-available }
        [SystemCriticalPercentage] { settings-critical-percentage }
        [RestoreDefaults] { settings-defaults }
        [InstalledVersion] { settings-installed-version }
        [RemoteVersion] { settings-github-version }
        [CheckUpdates] { settings-check-updates }
        [StartUpdate] { settings-start-update }
       *[other] { $field }
    }

settings-category-name =
    { $category ->
        [Appearance] { ui-settings-appearance }
        [RegionTime] { ui-settings-region-time }
        [System] { ui-settings-system }
        [FileExplorer] { ui-settings-file-explorer }
        [Editor] { ui-settings-editor }
        [Update] { ui-settings-update }
       *[other] { $category }
    }

