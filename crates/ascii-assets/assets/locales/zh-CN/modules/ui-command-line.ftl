# UI command-line messages.

ui-command-line-command-line = Command Line

ui-command-line-minimum-size = Command Line needs at least { $min_command_line_terminal_width }x{ $min_command_line_terminal_height } terminal cells. Resize to continue.

ui-command-line-exited = CLI exited ({ $code }); Enter restart · use the top-right button to return

ui-command-line-failed = { $message } · Enter restart · use the top-right button to return
