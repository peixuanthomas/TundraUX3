# UI command-line messages.

ui-command-line-command-line = 命令行

ui-command-line-minimum-size = 命令行至少需要 { $min_command_line_terminal_width }x{ $min_command_line_terminal_height } 个终端单元格。请调整大小以继续。

ui-command-line-exited = 命令行已退出（{ $code }）；Enter 重启 · Esc 启动器

ui-command-line-failed = { $message } · Enter 重启 · Esc 启动器
